tmp/# --- Python ---
# Byte-compiled / optimized / C extensions
__pycache__/
*.pyc
*.pyo
*.pyd

# Egg-info files (generated by setuptools)
*.egg-info/
.eggs/

# Virtual Environments
# It's best practice to not commit your virtual environment
venv/
env/
.venv/
*_env/
env.bak/
venv.bak/


# --- Project-specific ---
# Ignore generated output files
for_further_analysis.xlsx
*.xlsx # A more general rule to ignore all Excel files in the root

# Ignore log files
data_mapping_log.txt
*.log

# Ignore the input data directory.
# Data should typically be kept separate from the code repository.
# If you want to commit the empty directory structure, add a .gitkeep file inside it.
balances/

# But DO NOT ignore the .gitkeep file, which preserves the empty directory
!balances/.gitkeep


# --- IDE / Editor Configuration ---
# Visual Studio Code
.vscode/

# PyCharm
.idea/

# Sublime Text
.sublime-project
.sublime-workspace


# --- Environment Variables ---
# Ignore files containing sensitive credentials or environment-specific settings
.env
.env.*


# --- Operating System Files ---
# macOS
.DS_Store

# Windows
Thumbs.db


# --- Other ---
# Jupyter Notebook checkpoints
.ipynb_checkpoints

temp/

